function toggleRefinement(btn, skillId, refId) {
  if (!state.skillAnswers[skillId]) state.skillAnswers[skillId] = [];
  const arr = state.skillAnswers[skillId];
  const idx = arr.indexOf(refId);
  if (idx >= 0) arr.splice(idx, 1);
  else arr.push(refId);
  btn.classList.toggle('selected');

  const nextBtn = document.getElementById('refinementNextBtn');
  if (nextBtn) nextBtn.disabled = arr.length === 0;
}

function submitRefinement() {
  buildRecommendationsForCurrentSkill();
  state.currentSkillIdx++;
  if (state.currentSkillIdx >= state.selectedSkills.length) {
    go('summary');
  } else {
    go('refinement');
  }
}

// ============ ФИЛЬТРАЦИЯ ============
function buildRecommendationsForCurrentSkill() {
  const skill = SKILLS.find(s => s.id === state.selectedSkills[state.currentSkillIdx]);
  const refIds = state.skillAnswers[skill.id] || [];
  const programs = [];
  const useFilter = state.formats.length > 0 && !state.filterDisabled;

  refIds.forEach(refId => {
    const ref = skill.refinements.find(r => r.id === refId);
    if (!ref) return;
    ref.programs.forEach(p => {
      if (state.studiedPrograms.includes(p)) return;
      const formats = getProgramFormats(p);
      if (useFilter) {
        const matches = formats.some(f => state.formats.includes(f));
        if (!matches) return;
      }
      programs.push({
        program: p,
        format: formats,
        skillId: skill.id,
        refinementId: refId,
        refinementText: ref.text
      });
    });
  });
  state.recommendations[skill.id] = programs;
}

