<script>
(function() {
  // На мобильных курсор не инициализируем
  if (window.innerWidth <= 768) return;

  const cursor = document.getElementById("cursor");
  if (!cursor) return;

  const amount = 20;
  const sineDots = Math.floor(amount * 0.3);
  const width = 13;
  const idleTimeout = 150;

  let lastFrame = 0;
  let mousePosition = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
  let dots = [];
  let timeoutID;
  let idle = false;

  class Dot {
    constructor(index = 0) {
      this.index = index;
      this.anglespeed = 0.05;
      this.x = 0;
      this.y = 0;
      this.baseScale = 1 - 0.05 * index;
      this.scale = this.baseScale;
      this.range = width / 2 - width / 2 * this.scale + 2;
      this.limit = width * 0.75 * this.scale;
      this.element = document.createElement("span");
      this.opacity = 1 - (index / amount) * 0.8;
      gsap.set(this.element, { scale: this.scale, opacity: this.opacity });
      cursor.appendChild(this.element);
    }
    lock() {
      this.lockX = this.x;
      this.lockY = this.y;
      this.angleX = Math.PI * 2 * Math.random();
      this.angleY = Math.PI * 2 * Math.random();
    }
    draw() {
      if (!idle || this.index <= sineDots) {
        gsap.set(this.element, { x: this.x, y: this.y });
      } else {
        this.angleX += this.anglespeed;
        this.angleY += this.anglespeed;
        this.y = this.lockY + Math.sin(this.angleY) * this.range;
        this.x = this.lockX + Math.sin(this.angleX) * this.range;
        gsap.set(this.element, { x: this.x, y: this.y });
      }
    }
    setHover(active) {
      const mult = active ? 1.7 : 1;
      this.scale = this.baseScale * mult;
      this.range = width / 2 - width / 2 * this.scale + 2;
      this.limit = width * 0.75 * this.scale;
      gsap.to(this.element, { duration: 0.3, scale: this.scale, ease: "power2.out" });
    }
  }

  function init() {
    window.addEventListener("mousemove", onMouseMove);
    window.addEventListener("touchmove", onTouchMove, { passive: true });
    lastFrame += new Date();
    buildDots();
    render();

    const interactiveSelector = "button, a, input, textarea, select, .option, .card, .tab, .btn-primary, .btn-secondary, .btn-ghost, .btn-like, .btn-archive";
    let hoverActive = false;

    document.addEventListener("mouseover", (e) => {
      const target = e.target;
      if (target && target.closest && target.closest(interactiveSelector)) {
        if (!hoverActive) {
          hoverActive = true;
          dots.forEach(d => d.setHover(true));
        }
      }
    });

    document.addEventListener("mouseout", (e) => {
      const from = e.target;
      const to = e.relatedTarget;
      const fromInteractive = from && from.closest && from.closest(interactiveSelector);
      const toInteractive = to && to.closest && to.closest(interactiveSelector);
      if (fromInteractive && !toInteractive && hoverActive) {
        hoverActive = false;
        dots.forEach(d => d.setHover(false));
      }
    });
  }

  function startIdleTimer() {
    timeoutID = setTimeout(goInactive, idleTimeout);
    idle = false;
  }
  function resetIdleTimer() {
    clearTimeout(timeoutID);
    startIdleTimer();
  }
  function goInactive() {
    idle = true;
    for (let dot of dots) dot.lock();
  }
  function buildDots() {
    for (let i = 0; i < amount; i++) {
      dots.push(new Dot(i));
    }
  }

  const onMouseMove = (event) => {
    mousePosition.x = event.clientX - width / 2;
    mousePosition.y = event.clientY - width / 2;
    resetIdleTimer();
  };
  const onTouchMove = (event) => {
    if (!event.touches || !event.touches[0]) return;
    mousePosition.x = event.touches[0].clientX - width / 2;
    mousePosition.y = event.touches[0].clientY - width / 2;
    resetIdleTimer();
  };

  const render = (timestamp) => {
    positionCursor();
    lastFrame = timestamp;
    requestAnimationFrame(render);
  };

  const positionCursor = () => {
    let x = mousePosition.x;
    let y = mousePosition.y;
    dots.forEach((dot, index, arr) => {
      let nextDot = arr[index + 1] || arr[0];
      dot.x = x;
      dot.y = y;
      dot.draw();
      if (!idle || index <= sineDots) {
        const dx = (nextDot.x - dot.x) * 0.35;
        const dy = (nextDot.y - dot.y) * 0.35;
        x += dx;
        y += dy;
      }
    });
  };

  function start() {
    if (!window.gsap) return;                                   // библиотека не загрузилась — оставляем системный курсор
    if (window.matchMedia('(forced-colors: active)').matches) return;
    if (start.done) return;
    start.done = true;
    init();
    document.documentElement.classList.add('has-custom-cursor');
  }
  if (window.gsap) {
    start();
  } else {
    window.addEventListener("load", start);
  }
})();
</script>
