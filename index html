<script>
(function(){
  const modalIds=['inventoryModal','programModal','catalogModal'];
  const lastFocus={};
  function visibleModal(){return modalIds.map(id=>document.getElementById(id)).filter(el=>el?.classList.contains('active')).pop();}
  function modalFocus(modal){return [...modal.querySelectorAll('button:not([disabled]),input:not([disabled]),[tabindex="0"]')].filter(el=>el.getClientRects().length);}
  function syncModal(){
    modalIds.forEach(id=>{const el=document.getElementById(id);el.setAttribute('aria-hidden',String(!el.classList.contains('active')));});
  }
  function onOpen(modal){
    if(!modal) return;
    lastFocus[modal.id]=document.activeElement;
    syncModal();
    const first=modalFocus(modal)[0];
    if(first) first.focus({preventScroll:true});
  }
  function onClose(modal){
    syncModal();
    const another=visibleModal();
    if(another){const first=modalFocus(another)[0];if(first)first.focus({preventScroll:true});return;}
    const target=lastFocus[modal.id];
    if(target?.isConnected)target.focus({preventScroll:true});
  }
  modalIds.forEach(id=>{
    const el=document.getElementById(id);
    const observer=new MutationObserver(()=>{
      if(el.classList.contains('active'))onOpen(el);else onClose(el);
    });
    observer.observe(el,{attributes:true,attributeFilter:['class']});
  });
  document.addEventListener('keydown',e=>{
    const modal=visibleModal();
    if(modal){
      if(e.key==='Escape'){
        e.preventDefault();
        ({inventoryModal:closeInventory,programModal:closeProgramCard,catalogModal:closeCatalog})[modal.id]();
        return;
      }
      if(e.key==='Tab'){
        const items=modalFocus(modal);if(!items.length)return;
        const first=items[0],last=items[items.length-1];
        if(e.shiftKey&&(document.activeElement===first||!modal.contains(document.activeElement))){e.preventDefault();last.focus();}
        else if(!e.shiftKey&&(document.activeElement===last||!modal.contains(document.activeElement))){e.preventDefault();first.focus();}
      }
      return;
    }
    if((e.key==='Enter'||e.key===' ')&&e.target.matches('[role="button"][tabindex="0"]')){
      if(e.target.closest('button'))return;
      e.preventDefault();
      if(e.target.classList.contains('card-inner') && typeof e.target.onclick === 'function') e.target.onclick.call(e.target,e);
      else e.target.click();
    }
  });
  document.addEventListener('click',e=>{
    const b=e.target.closest('button.option,button.btn-secondary,button.chip');
    if(b)queueMicrotask(()=>{
      const scope=b.closest('#studiedOptions,#studiedProgramsBlock,#formatOptions,#skillsOptions,#main,#catalogChips');
      if(scope)scope.querySelectorAll('button.option,button.btn-secondary,button.chip').forEach(btn=>btn.setAttribute('aria-pressed',String(btn.classList.contains('selected')||btn.classList.contains('active'))));
    });
  });
  const observer=new MutationObserver(()=>{
    document.querySelectorAll('button.option,button.btn-secondary,button.chip').forEach(b=>{
      if(!b.hasAttribute('aria-pressed'))b.setAttribute('aria-pressed',String(b.classList.contains('selected')||b.classList.contains('active')));
    });
  });
  observer.observe(document.getElementById('app'),{childList:true,subtree:true});
  document.querySelectorAll('button.option,button.btn-secondary,button.chip').forEach(b=>b.setAttribute('aria-pressed',String(b.classList.contains('selected')||b.classList.contains('active'))));
})();
</script>

<script>
/* ============ Подгонка экрана: постраничное листание вместо вертикального скролла ============
   Только отображение. Если список не помещается в окно, он делится на страницы
   (стрелки, точки, свайп вбок). Данные, выбор и обработчики не затрагиваются. */
(function () {
  const FIT_LISTS = '#formatOptions, #skillsOptions, #refinementOptions, #tabContent .cards';
  const SWIPE_LISTS = '#formatOptions, #skillsOptions, #refinementOptions';

  function mainEl() { return document.getElementById('main'); }
  function listItems(list) { return [...list.children].filter(el => !el.classList.contains('pager')); }
  function overflowing(list) {
    const m = mainEl();
    return m.scrollHeight > m.clientHeight + 2 ||
           list.scrollHeight > list.clientHeight + 2 ||
           list.scrollWidth > list.clientWidth + 2;
  }
  function reset(list) {
    list.classList.remove('is-paged');
    list.style.removeProperty('--page-cols');
    listItems(list).forEach(el => { el.hidden = false; });
    const pager = list.nextElementSibling;
    if (pager && pager.classList.contains('pager')) pager.remove();
    delete list._fit;
  }
  function showRange(items, from, to) {
    items.forEach((el, i) => { el.hidden = !(i >= from && i < to); });
  }
  function renderPager(list) {
    const f = list._fit;
    const pages = Math.ceil(f.items.length / f.per);
    const pager = f.pager;
    pager.querySelector('.pager-dots').innerHTML = Array.from({ length: pages }, (_, i) => `<i class="${i === f.page ? 'on' : ''}"></i>`).join('');
    pager.querySelector('.pager-label').textContent = (f.page + 1) + ' / ' + pages;
    pager.querySelector('[data-dir="-1"]').disabled = f.page === 0;
    pager.querySelector('[data-dir="1"]').disabled = f.page >= pages - 1;
  }
  function goPage(list, delta) {
    const f = list._fit;
    if (!f) return false;
    const pages = Math.ceil(f.items.length / f.per);
    const next = Math.min(pages - 1, Math.max(0, f.page + delta));
    if (next === f.page) return false;
    f.page = next;
    showRange(f.items, f.page * f.per, (f.page + 1) * f.per);
    renderPager(list);
    return true;
  }
  function paginate(list) {
    const items = listItems(list);
    if (items.length < 2) return;
    list.classList.add('is-paged');
    const pager = document.createElement('div');
    pager.className = 'pager';
    pager.innerHTML = '<button type="button" class="pager-arrow" data-dir="-1" aria-label="Предыдущая страница">‹</button>' +
      '<span class="pager-dots" aria-hidden="true"></span><span class="pager-label" aria-live="polite"></span>' +
      '<button type="button" class="pager-arrow" data-dir="1" aria-label="Следующая страница">›</button>';
    list.after(pager);
    // Колонки: сколько афиш помещается в ширину при постраничном показе.
    if (list.matches('#formatOptions, #skillsOptions')) {
      const base = window.innerWidth >= 1100 ? 4 : (window.innerWidth >= 700 ? 2 : 1);
      list.style.setProperty('--page-cols', String(base));
    }
    let per = items.length - 1;
    for (; per > 1; per--) {
      showRange(items, 0, per);
      if (!overflowing(list)) break;
    }
    per = Math.max(1, per);
    // Ровные страницы: на всех страницах одинаковое число карточек.
    const pages = Math.ceil(items.length / per);
    per = Math.ceil(items.length / pages);
    if (list.style.getPropertyValue('--page-cols')) {
      list.style.setProperty('--page-cols', String(Math.min(Number(list.style.getPropertyValue('--page-cols')), per)));
    }
    list._fit = { items, per, page: 0, pager };
    showRange(items, 0, per);
    renderPager(list);
    pager.addEventListener('click', e => {
      const b = e.target.closest('[data-dir]');
      if (!b) return;
      goPage(list, Number(b.dataset.dir));
      // Стрелка стала неактивной (первая/последняя страница) — переносим фокус на соседнюю, чтобы он не терялся.
      if (b.disabled && document.activeElement === b || b.disabled) {
        const other = pager.querySelector(`[data-dir="${-Number(b.dataset.dir)}"]`);
        if (other && !other.disabled) other.focus();
      }
    });
  }
  function attachSwipe(el, onSwipe) {
    if (el._swipeBound) return;
    el._swipeBound = true;
    let x0 = 0, y0 = 0, moved = false;
    el.addEventListener('touchstart', e => {
      if (e.touches.length !== 1) return;
      x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; moved = false;
    }, { passive: true });
    el.addEventListener('touchend', e => {
      const t = e.changedTouches[0];
      const dx = t.clientX - x0, dy = t.clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.3) {
        moved = onSwipe(dx < 0 ? 1 : -1);
      }
    });
    el.addEventListener('click', e => {
      if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; }
    }, true);
  }
  function fitScreen() {
    const m = mainEl();
    if (!m) return;
    const lists = [...m.querySelectorAll(FIT_LISTS)];
    lists.forEach(reset);
    lists.forEach(list => {
      if (list.offsetParent === null) return;
      // Телефон: навыки и уточнения прокручиваются вертикально, без листания страниц.
      if (window.innerWidth < 700 && list.matches('#skillsOptions, #refinementOptions, #formatOptions, #tabContent .cards')) return;
      if (overflowing(list)) paginate(list);
      if (list.matches(SWIPE_LISTS)) attachSwipe(list, dir => goPage(list, dir));
    });
    const grid = document.getElementById('studiedGrid');
    if (grid) attachSwipe(grid, dir => {
      const before = typeof studiedPage === 'number' ? studiedPage : 0;
      studiedGoPage(dir);
      return studiedPage !== before;
    });
  }
  // Описания на афишах форматов и навыков: самый крупный размер, при котором текст целиком
  // помещается в каждую афишу (одинаковый для всех афиш на экране).
  function fitPosterTexts() {
    ['#formatOptions', '#skillsOptions'].forEach(sel => {
      const descs = [...document.querySelectorAll(sel + ' .poster .poster-desc')];
      if (!descs.length) return;
      descs.forEach(d => { d.style.fontSize = ''; });
      const visible = descs.filter(d => d.offsetParent !== null);
      if (!visible.length) return;
      let fs = Math.min(...visible.map(d => parseFloat(getComputedStyle(d).fontSize)));
      const fits = () => visible.every(d => { const b = d.closest('.poster-body'); return b.scrollHeight <= b.clientHeight + 1; });
      descs.forEach(d => { d.style.fontSize = fs + 'px'; });
      while (fs > 11 && !fits()) {
        fs -= 0.5;
        descs.forEach(d => { d.style.fontSize = fs + 'px'; });
      }
    });
  }
  const fitScreenBase = fitScreen;
  fitScreen = function () { fitScreenBase(); fitPosterTexts(); };
  window.fitScreen = fitScreen;
  const baseStudiedGoPage = studiedGoPage;
  studiedGoPage = function (delta) {
    const active = document.activeElement;
    baseStudiedGoPage.apply(this, arguments);
    if (active && active.disabled) {
      const other = document.getElementById(active.id === 'studiedNext' ? 'studiedPrev' : 'studiedNext');
      if (other && !other.disabled) other.focus();
    }
  };

  // Смена экрана через View Transitions: браузер показывает плавный переход вместо мигания.
  // Если браузер этого не умеет — экран меняется мгновенно, тоже без вспышки.
  const baseGo = go;
  let transitioning = false;
  go = function () {
    const args = arguments;
    if (!document.startViewTransition || transitioning ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return baseGo.apply(this, args);
    }
    transitioning = true;
    const t = document.startViewTransition(() => { try { baseGo.apply(this, args); } finally { transitioning = false; } });
    t.finished.finally(() => { transitioning = false; });
  };

  // Карточка программы: подбираем размер текста, чтобы всё помещалось без прокрутки.
  function fitProgramModal() {
    const modal = document.querySelector('#programModal .modal');
    if (!modal || !document.getElementById('programModal').classList.contains('active')) return;
    // На телефоне текст не мельчим: там описание длиннее экрана, окно прокручивается.
    const phone = window.innerWidth < 700;
    let fs = phone ? 14 : 16;
    const minFs = phone ? 14 : 11;
    modal.style.setProperty('--pm-fs', fs + 'px');
    while (fs > minFs && modal.scrollHeight > modal.clientHeight + 1) {
      fs -= 0.5;
      modal.style.setProperty('--pm-fs', fs + 'px');
    }
    modal.scrollTop = 0;
  }
  const baseOpenProgramCard = openProgramCard;
  openProgramCard = function () { baseOpenProgramCard.apply(this, arguments); fitProgramModal(); };
  window.addEventListener('resize', () => requestAnimationFrame(fitProgramModal));

  // Сообщение об ошибке убирается, как только человек отвечает.
  const baseSetStudied = setStudied;
  setStudied = function () { baseSetStudied.apply(this, arguments); clearInlineError('studiedOptions'); };
  const baseToggleSkill = toggleSkill;
  toggleSkill = function () { baseToggleSkill.apply(this, arguments); clearInlineError('skillsOptions'); };
  document.addEventListener('input', e => { if (e.target && e.target.id === 'f-own') clearInlineError('skillsOptions'); });

  // Пункт 5: состояние «Интересно» / «Подумать» сообщается экранному диктору.
  function syncCardPressed(card) {
    if (!card) return;
    const like = card.querySelector('.btn-like'), think = card.querySelector('.btn-archive');
    if (like) like.setAttribute('aria-pressed', String(card.classList.contains('liked')));
    if (think) think.setAttribute('aria-pressed', String(card.classList.contains('archived')));
  }
  function announce(text) {
    const s = document.getElementById('a11yStatus');
    if (!s) return;
    s.textContent = '';
    setTimeout(() => { s.textContent = text; }, 50);
  }
  function wrapMark(fnName, label) {
    const base = window[fnName];
    window[fnName] = function (btn) {
      base.apply(this, arguments);
      const card = btn && btn.closest('.card');
      syncCardPressed(card);
      if (card) {
        const title = (card.querySelector('.card-open') || card.querySelector('.card-title'));
        const name = title ? title.firstChild.textContent.trim() : 'Программа';
        const on = card.classList.contains(fnName === 'likeProgramSummary' ? 'liked' : 'archived');
        announce(on ? `${name} — отмечено «${label}»` : `${name} — отметка «${label}» снята`);
      }
    };
  }
  wrapMark('likeProgramSummary', 'Интересно');
  wrapMark('archiveProgramSummary', 'Подумать');

  const baseRender = render;
  render = function () { baseRender.apply(this, arguments); fitScreen(); };
  const baseSwitchTab = switchTab;
  switchTab = function () {
    baseSwitchTab.apply(this, arguments);
    document.querySelectorAll('#tabContent .card').forEach(syncCardPressed);
    fitScreen();
  };

  let t = null;
  let lastW = window.innerWidth;
  window.addEventListener('resize', () => {
    clearTimeout(t);
    t = setTimeout(() => {
      // Экран «пройденные программы» пересчитывает число плиток на странице.
      if (state.screen === 'studied' && Math.abs(window.innerWidth - lastW) > 40) render();
      else fitScreen();
      lastW = window.innerWidth;
    }, 150);
  });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitScreen);
  fitScreen();
})();
</script>
</body>
</html>
