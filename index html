// ============ СООБЩЕНИЯ ОБ ОШИБКАХ (вместо alert) ============
// Сообщение появляется рядом с вопросом, читается экранным диктором (role="alert")
// и связано с группой вариантов через aria-describedby. Исчезает, как только человек делает выбор.
function showInlineError(targetId, text) {
  const target = document.getElementById(targetId);
  if (!target) { alert(text); return; }
  const id = targetId + 'Error';
  let box = document.getElementById(id);
  if (!box) {
    box = document.createElement('div');
    box.id = id;
    box.className = 'form-error';
    box.setAttribute('role', 'alert');
    // На экране навыков сообщение встаёт в строку с кнопкой «Далее», чтобы не сдвигать афиши.
    const actions = target.closest('.screen') && target.closest('.screen').querySelector(':scope > .actions');
    if (targetId === 'skillsOptions' && actions) actions.prepend(box);
    else target.after(box);
  }
  box.textContent = '';
  requestAnimationFrame(() => { box.textContent = text; });
  target.setAttribute('aria-describedby', id);
  if (box.scrollIntoView) box.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
}
function clearInlineError(targetId) {
  const box = document.getElementById(targetId + 'Error');
  if (box) box.remove();
  const target = document.getElementById(targetId);
  if (target) target.removeAttribute('aria-describedby');
}

