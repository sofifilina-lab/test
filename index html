function validateField(labelId, inputId) {
  const label = document.getElementById(labelId);
  const input = document.getElementById(inputId);
  if (!label || !input) return;
  const val = input.value;
  if (!val.trim()) {
    label.classList.remove('invalid');
    input.setAttribute('aria-invalid','false');
    return;
  }
  if (isMeaningful(val)) label.classList.remove('invalid');
  else label.classList.add('invalid');
  input.setAttribute('aria-invalid', String(label.classList.contains('invalid')));
}

function renderStudiedProgramsBlockHTML() {
  const all = getAllPrograms().slice().sort((a, b) => a.localeCompare(b, 'ru'));
  return `
    <p class="muted">Выберите программы, которые вы уже проходили:</p>
    <div class="options">
      ${all.map(p => `
        <button class="option ${state.studiedPrograms.includes(p) ? 'selected' : ''}" onclick="toggleStudiedProgram(this, ${JSON.stringify(p).replace(/"/g, '&quot;')})">${p}</button>
      `).join('')}
    </div>
    <button class="btn-secondary ${state.studiedUnsure ? 'selected' : ''}" onclick="diagNotRemember()">Не помню</button>
    <button class="btn-ghost" onclick="diagSkip()">Пропустить</button>
  `;
}

function setStudied(v) {
  syncFieldsToState();
  state.user.studied = v;

  const values = [true, false, 'unsure'];
  document.querySelectorAll('#studiedOptions .option').forEach((el, i) => {
    el.classList.toggle('selected', values[i] === v);
  });

  const block = document.getElementById('studiedProgramsBlock');
  block.style.display = (v === true || v === 'unsure') ? 'block' : 'none';
}

function syncFieldsToState() {
  const el = document.getElementById('f-name');
  if (el) state.user.name = el.value;
}

function toggleStudiedProgram(btn, p) {
  const idx = state.studiedPrograms.indexOf(p);
  if (idx >= 0) state.studiedPrograms.splice(idx, 1);
  else state.studiedPrograms.push(p);
  state.studiedUnsure = false;
  btn.classList.toggle('selected');
  const unsureBtn = document.querySelector('#studiedProgramsBlock .btn-secondary');
  if (unsureBtn) unsureBtn.classList.remove('selected');
}

function diagNotRemember() {
  const wasUnsure = state.studiedUnsure;
  state.studiedPrograms = [];
  state.studiedUnsure = !wasUnsure;

  document.querySelectorAll('#studiedProgramsBlock .option').forEach(el => el.classList.remove('selected'));

  const unsureBtn = document.querySelector('#studiedProgramsBlock .btn-secondary');
  if (unsureBtn) {
    unsureBtn.classList.toggle('selected', state.studiedUnsure);
  }
}

function diagSkip() {
  syncFieldsToState();
  const u = state.user;

  const nameLabel = document.getElementById('lbl-name');
  let hasError = false;
  if (!u.name.trim() || !isMeaningful(u.name)) {
    if (nameLabel) nameLabel.classList.add('invalid');
    hasError = true;
  } else {
    if (nameLabel) nameLabel.classList.remove('invalid');
  }

  const nameInput = document.getElementById('f-name');
  if (nameInput) nameInput.setAttribute('aria-invalid', String(hasError));
  if (hasError) {
    const firstInvalid = document.querySelector('label.invalid');
    if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return;
  }

  if (u.studied === null) {
    showInlineError('studiedOptions', 'Пожалуйста, ответьте на вопрос про ранее пройденное обучение.');
    return;
  }

  go('format');
}

function submitDiagnostics() {
  syncFieldsToState();
  const u = state.user;

  const nameLabel = document.getElementById('lbl-name');
  let hasError = false;
  if (!u.name.trim() || !isMeaningful(u.name)) {
    if (nameLabel) nameLabel.classList.add('invalid');
    hasError = true;
  } else {
    if (nameLabel) nameLabel.classList.remove('invalid');
  }

  if (hasError) {
    const firstInvalid = document.querySelector('label.invalid');
    if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return;
  }

  if (u.studied === null) {
    showInlineError('studiedOptions', 'Пожалуйста, ответьте на вопрос про ранее пройденное обучение.');
    return;
  }

  // Пройденные программы — отдельный экран со страницами на всех устройствах (на телефоне длинный список не помещался в экран).
  if (u.studied === true || u.studied === 'unsure') {
    studiedPage = 0;
    go('studied');
    return;
  }

  go('format');
}

// ============ ПРОЙДЕННЫЕ ПРОГРАММЫ (десктоп, бенто) ============
let studiedPage = 0;

function isDesktopLayout() {
  return window.matchMedia('(min-width: 1100px)').matches;
}

function studiedPerPage() {
  // Телефон: одна колонка, столько плиток, сколько помещается по высоте.
  if (window.innerWidth < 700) return Math.max(3, Math.min(9, Math.floor((window.innerHeight - 430) / 72)));
  // Планшет: две колонки.
  if (window.innerWidth < 1100) return window.innerHeight >= 900 ? 14 : 8;
  return window.innerHeight >= 780 ? 15 : 10;
}

function studiedAllPrograms() {
  return getAllPrograms().slice().sort((a, b) => a.localeCompare(b, 'ru'));
}

function studiedPageItems(page) {
  const perPage = studiedPerPage();
  return studiedAllPrograms().slice(page * perPage, (page + 1) * perPage);
}

function studiedPageCount() {
  return Math.max(1, Math.ceil(studiedAllPrograms().length / studiedPerPage()));
}

function studiedTilesHTML(items) {
  return items.map(p => `
    <button type="button" class="option studied-tile ${p.length > 50 ? 'is-wide' : ''} ${state.studiedPrograms.includes(p) ? 'selected' : ''}" aria-pressed="${state.studiedPrograms.includes(p)}" onclick="studiedToggle(this, ${JSON.stringify(p).replace(/"/g, '&quot;')})">${p}</button>
  `).join('');
}

function studiedPageLabel(page, items) {
  const range = items.length ? `${items[0][0].toUpperCase()}–${items[items.length - 1][0].toUpperCase()}` : '';
  return `Страница ${page + 1} из ${studiedPageCount()} · ${range}`;
}

function renderStudied() {
  const pages = studiedPageCount();
  if (studiedPage > pages - 1) studiedPage = pages - 1;
  if (studiedPage < 0) studiedPage = 0;
  const items = studiedPageItems(studiedPage);
  const count = state.studiedPrograms.length;

  document.getElementById('main').innerHTML = `
    <div class="screen active studied-screen">
      <h1>Какие программы вы уже проходили?</h1>
      <p class="muted">Отметьте все программы, которые помните. Листайте страницы стрелками или свайпом. Если не помните — нажмите «Не помню».</p>
      <div class="studied-pager">
        <button type="button" class="studied-arrow" id="studiedPrev" aria-label="Предыдущая страница" onclick="studiedGoPage(-1)" ${studiedPage === 0 ? 'disabled' : ''}>‹</button>
        <span class="studied-page-label" id="studiedPageLabel" aria-live="polite">${studiedPageLabel(studiedPage, items)}</span>
        <button type="button" class="studied-arrow" id="studiedNext" aria-label="Следующая страница" onclick="studiedGoPage(1)" ${studiedPage >= pages - 1 ? 'disabled' : ''}>›</button>
        <span class="studied-count" id="studiedCount">${count ? `Выбрано: ${count}` : ''}</span>
      </div>
      <div class="studied-grid" id="studiedGrid"></div>
      <div class="studied-actions">
        <button type="button" class="btn-ghost" onclick="go('diagnostics')">Назад</button>
        <button type="button" class="btn-secondary ${state.studiedUnsure ? 'selected' : ''}" id="studiedUnsureBtn" onclick="studiedNotRemember()">Не помню</button>
        <button type="button" class="btn-primary" onclick="studiedNext()">Далее</button>
      </div>
    </div>
  `;

  // Same grid height on every page, so the buttons below never jump.
  const grid = document.getElementById('studiedGrid');
  let maxH = 0;
  for (let i = 0; i < pages; i++) {
    grid.innerHTML = studiedTilesHTML(studiedPageItems(i));
    maxH = Math.max(maxH, grid.offsetHeight);
  }
  grid.style.minHeight = maxH + 'px';
  grid.innerHTML = studiedTilesHTML(items);
}

function studiedGoPage(delta) {
  const pages = studiedPageCount();
  const next = Math.min(pages - 1, Math.max(0, studiedPage + delta));
  if (next === studiedPage) return;
  studiedPage = next;
  const items = studiedPageItems(studiedPage);
  // Only the tiles, the page label and the arrows change; the screen itself stays in place.
  document.getElementById('studiedGrid').innerHTML = studiedTilesHTML(items);
  document.getElementById('studiedPageLabel').textContent = studiedPageLabel(studiedPage, items);
  document.getElementById('studiedPrev').disabled = studiedPage === 0;
  document.getElementById('studiedNext').disabled = studiedPage >= pages - 1;
}

// «Далее»: next page of programs; only on the last page go to the format screen.
function studiedNext() {
  if (studiedPage < studiedPageCount() - 1) {
    studiedGoPage(1);
    return;
  }
  go('format');
}

function studiedToggle(btn, p) {
  const idx = state.studiedPrograms.indexOf(p);
  if (idx >= 0) state.studiedPrograms.splice(idx, 1);
  else state.studiedPrograms.push(p);
  state.studiedUnsure = false;
  const on = state.studiedPrograms.includes(p);
  btn.classList.toggle('selected', on);
  btn.setAttribute('aria-pressed', String(on));
  const unsureBtn = document.getElementById('studiedUnsureBtn');
  if (unsureBtn) unsureBtn.classList.remove('selected');
  const countEl = document.getElementById('studiedCount');
  if (countEl) countEl.textContent = state.studiedPrograms.length ? `Выбрано: ${state.studiedPrograms.length}` : '';
}

function studiedNotRemember() {
  // «Не помню»: сбрасываем отмеченные программы и сразу переходим к выбору формата.
  state.studiedPrograms = [];
  state.studiedUnsure = true;
  go('format');
}

