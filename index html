// «Далее» on the summary: open the next selected skill's tab; only after the last one go to «Вам подошла рекомендация?».
function summaryNext() {
  const tabs = [...document.querySelectorAll('#tabs .tab')];
  const current = tabs.findIndex(t => t.classList.contains('active'));
  if (current >= 0 && current < tabs.length - 1) {
    switchTab(current + 1);
    tabs[current + 1].focus({ preventScroll: true });
    return;
  }
  go('correct');
}

function switchTab(i) {
  document.querySelectorAll('.tab').forEach((t, idx) => { t.classList.toggle('active', idx === i); t.setAttribute('aria-pressed', String(idx === i)); });
  const sid = state.selectedSkills[i];
  const skill = SKILLS.find(x => x.id === sid);
  const recs = state.recommendations[sid] || [];
  const multiRef = (state.skillAnswers[sid] || []).length > 1;
  const content = document.getElementById('tabContent');
  if (recs.length === 0) {
    const filterActive = state.formats.length > 0 && !state.filterDisabled;
    if (filterActive) {
      content.innerHTML = `
        <div class="note">В данном формате нет этого навыка.</div>
        <p>Какой интересный запрос! Давайте обсудим его подробнее. Нажмите «Далее».</p>
      `;
    } else {
      content.innerHTML = '<p class="muted">Пока нет рекомендаций по этому навыку.</p>';
    }
    return;
  }
  content.innerHTML = `
    <div class="cards">
      ${recs.map((r, idx) => {
        const isLiked = state.inventory.some(x => x.program === r.program && x.skillId === skill.id);
        const isArchived = state.archive.some(x => x.program === r.program && x.skillId === skill.id);
        return `
                    <div class="card card-swipeable ${programColorClass(r.program, skill.id)} ${isLiked ? 'liked' : ''} ${isArchived ? 'archived' : ''}"
               data-skill-id="${sid}"
               data-rec-idx="${idx}">
            <div class="card-inner" style="cursor:pointer;" onclick="openProgramCard(${JSON.stringify(r.program).replace(/"/g, '&quot;')})">
              <div class="card-band" aria-hidden="true"><span class="${(FORMAT_POSTERS[r.format[0]] || DEFAULT_POSTER).two ? 'is-two' : ''}">${posterWordHTML(FORMAT_POSTERS[r.format[0]] || DEFAULT_POSTER)}</span></div>
              <div class="card-tags">
                <span class="card-format">${r.format.join(' / ') || 'Формат не указан'}</span>
                ${getProgramTrajectory(r.program) ? `<span class="card-format">${getProgramTrajectory(r.program)}</span>` : ''}
              </div>
              <div class="card-title"><button type="button" class="card-open">${r.program}<span class="sr-only"> — подробнее о программе</span></button></div>
              ${multiRef ? `<div class="card-refinement">По запросу: ${r.refinementText}</div>` : ''}
              <div class="card-actions">
                <button class="btn-archive" onclick="event.stopPropagation(); archiveProgramSummary(this, '${sid}', ${idx})">Подумать</button>
                <button class="btn-like" onclick="event.stopPropagation(); likeProgramSummary(this, '${sid}', ${idx})">Интересно</button>
              </div>
            </div>
          </div>
        `;
      }).join('')}
    </div>
  `;

  // Свайп вправо/влево по карточкам отключён: программы отмечаются только кнопками «Интересно» / «Подумать».
}

function likeProgramSummary(btn, skillId, i) {
  const skill = SKILLS.find(s => s.id === skillId);
  const rec = state.recommendations[skillId][i];
  const exists = state.inventory.some(x => x.program === rec.program && x.skillId === skill.id);
  if (exists) {
    state.inventory = state.inventory.filter(x => !(x.program === rec.program && x.skillId === skill.id));
  } else {
    state.archive = state.archive.filter(x => !(x.program === rec.program && x.skillId === skill.id));
    state.inventory.push({ program: rec.program, format: rec.format, skillId: skill.id });
  }

  const card = btn.closest('.card');
  if (card) {
    card.classList.toggle('liked', !exists);
    card.classList.remove('archived');
  }
}

function archiveProgramSummary(btn, skillId, i) {
  const skill = SKILLS.find(s => s.id === skillId);
  const rec = state.recommendations[skillId][i];
  const exists = state.archive.some(x => x.program === rec.program && x.skillId === skill.id);
  if (exists) {
    state.archive = state.archive.filter(x => !(x.program === rec.program && x.skillId === skill.id));
  } else {
    state.inventory = state.inventory.filter(x => !(x.program === rec.program && x.skillId === skill.id));
    state.archive.push({ program: rec.program, format: rec.format, skillId: skill.id });
  }

  const card = btn.closest('.card');
  if (card) {
    card.classList.toggle('archived', !exists);
    card.classList.remove('liked');
  }
}

// ============ СВАЙП-ЖЕСТЫ ============
function attachSwipeHandlers(card) {
  let startX = 0;
  let startY = 0;
  let currentX = 0;
  let currentY = 0;
  let isDragging = false;
  let gestureBlocked = false;
  const SWIPE_THRESHOLD = 60;
  const VERTICAL_LIMIT = 40;
  const DRAG_MULTIPLIER = 1.15;

  card.addEventListener('touchstart', (e) => {
    if (e.touches.length !== 1) return;
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
    currentX = startX;
    currentY = startY;
    isDragging = false;
    gestureBlocked = false;
  }, { passive: true });

  card.addEventListener('touchmove', (e) => {
    if (e.touches.length !== 1 || gestureBlocked) return;
    currentX = e.touches[0].clientX;
    currentY = e.touches[0].clientY;
    const dx = currentX - startX;
    const dy = currentY - startY;

    if (!isDragging && Math.abs(dy) > VERTICAL_LIMIT && Math.abs(dy) > Math.abs(dx)) {
      gestureBlocked = true;
      return;
    }

    if (Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) {
      isDragging = true;
      card.classList.add('dragging');
      if (dx > 0) {
        card.classList.add('dragging-right');
        card.classList.remove('dragging-left');
      } else {
        card.classList.add('dragging-left');
        card.classList.remove('dragging-right');
      }
      const inner = card.querySelector('.card-inner');
      if (inner) {
        const moved = dx * DRAG_MULTIPLIER;
        const rotate = moved / 20;
        inner.style.transform = `translateX(${moved}px) rotate(${rotate}deg)`;
      }
    }
  }, { passive: true });

  card.addEventListener('touchend', () => {
    if (!isDragging) return;
    const dx = currentX - startX;
    const skillId = card.getAttribute('data-skill-id');
    const recIdx = parseInt(card.getAttribute('data-rec-idx'), 10);

    card.classList.remove('dragging', 'dragging-left', 'dragging-right');

    if (Math.abs(dx) >= SWIPE_THRESHOLD) {
      const direction = dx > 0 ? 'right' : 'left';
      card.classList.add(direction === 'right' ? 'fly-right' : 'fly-left');

      const inner = card.querySelector('.card-inner');
      if (inner) inner.style.transform = '';

      if (direction === 'right') {
        const btn = card.querySelector('.btn-like');
        if (btn) likeProgramSummary(btn, skillId, recIdx);
      } else {
        const btn = card.querySelector('.btn-archive');
        if (btn) archiveProgramSummary(btn, skillId, recIdx);
      }

      setTimeout(() => {
        card.classList.remove('fly-right', 'fly-left');
      }, 400);

      card.dataset.suppressClick = '1';
      setTimeout(() => { card.dataset.suppressClick = ''; }, 500);
    } else {
      const inner = card.querySelector('.card-inner');
      if (inner) {
        inner.style.transform = '';
      }
    }

    isDragging = false;
  });

  card.addEventListener('click', (e) => {
    if (card.dataset.suppressClick === '1') {
      e.stopPropagation();
      e.preventDefault();
    }
  }, true);
}

