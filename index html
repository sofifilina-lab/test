      const bg = getComputedStyle(el).backgroundColor;
      if (bg && bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent') return isYellow(bg);
    }
    return false;
  }
  function update() {
    queued = false;
    cursor.classList.toggle('on-yellow', onYellow(document.elementFromPoint(x, y)));
  }
  window.addEventListener('mousemove', e => {
    x = e.clientX; y = e.clientY;
    if (!queued) { queued = true; requestAnimationFrame(update); }
  });
