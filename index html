function printRecommendations() {
  const seen = new Set();
  const groups = [];
  state.selectedSkills.forEach(sid => {
    const skill = SKILLS.find(x => x.id === sid);
    const recs = state.recommendations[sid] || [];
    const uniqueRecs = [];
    recs.forEach(r => {
      if (seen.has(r.program)) return;
      seen.add(r.program);
      uniqueRecs.push(r);
    });
    if (uniqueRecs.length > 0) {
      groups.push({ skill: skill.name, programs: uniqueRecs });
    }
  });

  let html = buildPrintHeader();

  if (groups.length === 0) {
    html += '<p>Рекомендации пусты.</p>';
  } else {
    html += '<h2 class="print-section-title">Ваши рекомендации</h2>';
    groups.forEach(g => {
      html += `<div class="print-skill">Навык: ${g.skill}</div>`;
            g.programs.forEach(r => {
        html += `
          <div class="print-program">
            <div class="print-program-name">${r.program}</div>
            <div class="print-program-format">Формат: ${r.format.join(' / ')}</div>
            <div class="print-program-desc">${getProgramDescription(r.program)}</div>
          </div>
        `;
      });
    });
  }

  html += `<div class="print-footer">Навигатор обучения — прототип</div>`;

  printHtml(html, 'навигатор-рекомендации');
}

function printFullCatalog() {
  const formatOrder = ['СкилЛаб', 'ЛабПро', 'Мастер Классы', 'СкилЛайт'];
  const all = getAllPrograms();
  const byFormat = {};
  formatOrder.forEach(f => byFormat[f] = []);
  all.forEach(p => {
    const fmts = getProgramFormats(p);
    const primary = fmts[0] || 'СкилЛаб';
    if (!byFormat[primary]) byFormat[primary] = [];
    byFormat[primary].push(p);
  });

  let html = buildPrintHeader();
  html += '<h2 class="print-section-title">Полный каталог программ</h2>';

  formatOrder.forEach(fmt => {
    const list = byFormat[fmt] || [];
    if (list.length === 0) return;
    html += `<div class="print-skill">Формат: ${fmt}</div>`;
        list.forEach(p => {
      html += `
        <div class="print-program">
          <div class="print-program-name">${p}</div>
          <div class="print-program-format">Формат: ${getProgramFormats(p).join(' / ')}</div>
          <div class="print-program-desc">${getProgramDescription(p)}</div>
        </div>
      `;
    });
  });

  html += `<div class="print-footer">Навигатор обучения — прототип</div>`;

  printHtml(html, 'навигатор-каталог');
}

function printHtml(html, title) {
  const area = document.getElementById('printArea');
  area.innerHTML = html;

  const originalTitle = document.title;
