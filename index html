function softHyphens(text) {
  return String(text || '').replace(/[А-Яа-яЁё]+/g, w => {
    const h = SOFT_HYPHENS[w.toLowerCase()];
    if (!h) return w;
    const out = h.replace(/-/g, '\u00AD');
