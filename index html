  function isYellow(color) {
    const m = color && color.match(/rgba?\(([^)]+)\)/);
    if (!m) return false;
    const [r, g, b, a = 1] = m[1].split(',').map(Number);
    return a > 0.5 && r > 215 && g > 185 && b < 130;
