const ALLOWED_PHRASES = [
  'не знаю',
  'не уверен',
  'не уверена',
  'не решил',
  'не решила',
  'затрудняюсь',
  'затрудняюсь ответить',
  'пока не знаю',
  'нет ответа',
  'без ответа'
];

const SHORT_ALLOWED_WORDS = [
  'it', 'hr', 'pr', 'qa', 'ux', 'ui', 'smm', 'crm', 'erp', 'kpi', 'okr'
];

const VOWELS = 'аеёиоуыэюяaeiouy';
const CONSONANTS = 'бвгджзйклмнпрстфхцчшщbcdfghjklmnpqrstvwxz';

function normalizeText(text) {
  return (text || '').toLowerCase().trim();
}

function isAllowedPhrase(text) {
  const t = normalizeText(text).replace(/[.,!?;:()]/g, '').replace(/\s+/g, ' ').trim();
  return ALLOWED_PHRASES.includes(t);
}

function isRepeatedSameLetter(clean) {
  if (clean.length < 2) return false;
  const first = clean[0];
  for (const ch of clean) {
    if (ch !== first) return false;
  }
  return true;
}

function hasLongConsonantCluster(clean) {
  let streak = 0;
  for (const ch of clean) {
    if (CONSONANTS.includes(ch)) {
      streak++;
      if (streak >= 4) return true;
    } else {
      streak = 0;
    }
  }
  return false;
}

function isMeaningfulWord(word) {
  const clean = word.replace(/[^a-zA-Zа-яА-ЯёЁ]/g, '');
  if (!clean) return false;

  if (SHORT_ALLOWED_WORDS.includes(clean.toLowerCase())) return true;

  if (clean.length < 3) return false;
  if (isRepeatedSameLetter(clean)) return false;

  let hasVowel = false;
  for (const ch of clean) {
    if (VOWELS.includes(ch)) { hasVowel = true; break; }
  }
  if (!hasVowel) return false;

  if (hasLongConsonantCluster(clean)) return false;

  return true;
}

function isMeaningful(text) {
  const t = normalizeText(text);
  if (!t) return false;
  if (isAllowedPhrase(t)) return true;
  const words = t.split(/\s+/);
  return words.some(w => isMeaningfulWord(w));
}

