// ============ ПОЛНЫЙ КАТАЛОГ ============
const CATALOG_FORMAT_ORDER = ['СкилЛаб', 'ЛабПро', 'Мастер Классы', 'СкилЛайт'];

const catalogState = {
  query: '',
  formats: []
};

function openCatalog() {
  catalogState.query = '';
  catalogState.formats = [];
  const search = document.getElementById('catalogSearch');
  if (search) search.value = '';

  renderCatalogChips();
  renderCatalogList();
  document.getElementById('catalogModal').classList.add('active');
}

function closeCatalog() {
  document.getElementById('catalogModal').classList.remove('active');
}

function renderCatalogChips() {
  const wrap = document.getElementById('catalogChips');
  if (!wrap) return;
  const chips = CATALOG_FORMAT_ORDER.map(f => {
    const active = catalogState.formats.includes(f) ? 'active' : '';
    return `<button class="chip ${active}" onclick="toggleCatalogFormat('${f}')">${f}</button>`;
  }).join('');
  const reset = catalogState.formats.length > 0
    ? `<button class="chip chip-reset" onclick="resetCatalogFormats()">Сбросить</button>`
    : '';
  wrap.innerHTML = chips + reset;
}

function toggleCatalogFormat(fmt) {
  const i = catalogState.formats.indexOf(fmt);
  if (i >= 0) catalogState.formats.splice(i, 1);
  else catalogState.formats.push(fmt);
  renderCatalogChips();
  renderCatalogList();
}

function resetCatalogFormats() {
  catalogState.formats = [];
  renderCatalogChips();
  renderCatalogList();
}

function getCatalogItems() {
  const all = getAllPrograms();
  return all.map(p => ({
    name: p,
    formats: getProgramFormats(p),
    trajectory: getProgramTrajectory(p),
    description: getProgramDescription(p) || ''
  }));
}

function renderCatalogList() {
  const listEl = document.getElementById('catalogList');
  const countEl = document.getElementById('catalogCount');
  const searchEl = document.getElementById('catalogSearch');
  if (!listEl) return;

  catalogState.query = (searchEl?.value || '').trim().toLowerCase();

  let items = getCatalogItems();

  if (catalogState.formats.length > 0) {
    items = items.filter(it =>
      it.formats.some(f => catalogState.formats.includes(f))
    );
  }

  if (catalogState.query) {
    const q = catalogState.query;
    items = items.filter(it =>
      it.name.toLowerCase().includes(q) ||
      it.description.toLowerCase().includes(q)
    );
  }

  items.sort((a, b) => {
    const fa = CATALOG_FORMAT_ORDER.indexOf(a.formats[0] || '');
    const fb = CATALOG_FORMAT_ORDER.indexOf(b.formats[0] || '');
    if (fa !== fb) return fa - fb;
    return a.name.localeCompare(b.name, 'ru');
  });

  if (countEl) countEl.textContent = `Найдено: ${items.length}`;

  if (items.length === 0) {
    listEl.innerHTML = `<div class="catalog-empty">Ничего не найдено.<br>Попробуйте изменить запрос или сбросить фильтры.</div>`;
    return;
  }

  listEl.innerHTML = items.map(it => {
    const traj = it.trajectory
      ? `<span class="card-format">${it.trajectory}</span>`
      : '';
    const fmt = it.formats.map(f => `<span class="card-format">${f}</span>`).join(' ');
    const desc = it.description
      ? `<div class="catalog-item-desc">${it.description}</div>`
      : '';
    return `
      <div class="catalog-item ${programColorClass(it.name)}" role="button" tabindex="0" onclick="openProgramCard(${JSON.stringify(it.name).replace(/"/g, '&quot;')})">
        <div>${fmt}${traj}</div>
        <div class="catalog-item-title">${it.name}</div>
        ${desc}
      </div>
    `;
  }).join('');
}

